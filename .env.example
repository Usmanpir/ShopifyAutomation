# ─────────────────────────────────────────────────────────────
# CommerceAI environment. Copy to `.env` (never commit `.env`).
# Integrations are optional: without credentials the app runs in demo mode.
# ─────────────────────────────────────────────────────────────

# Core
DATABASE_URL="postgresql://commerceai:commerceai@localhost:5434/commerceai?schema=public"
REDIS_URL="redis://localhost:6379"            # optional; without it jobs run inline
APP_URL="http://localhost:3000"                # public base URL (OAuth + webhook callbacks)
NEXT_PUBLIC_APP_NAME="CommerceAI"              # product name shown in the UI

# Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
ENCRYPTION_KEY=""                              # base64, exactly 32 bytes (AES-256-GCM for stored credentials)
CRON_SECRET=""                                 # protects /api/cron/* (Vercel Cron sends it as a Bearer token)
INLINE_JOBS=""                                 # "true" to run jobs in-process even when Redis is set

# Shopify (Partner app)
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_WEBHOOK_SECRET=""                      # defaults to the client secret when empty
SHOPIFY_API_VERSION="2026-07"
SHOPIFY_SCOPES="read_products,write_products,read_orders,write_orders,read_customers,read_inventory,write_inventory,read_fulfillments,write_fulfillments"

# Meta (Facebook / Instagram / Ads / WhatsApp webhooks)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_VERSION="v23.0"

# WhatsApp Cloud API (or connect per store from Integrations)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# AI providers — choose per store in Settings → AI; "local" needs no key
AI_PROVIDER="local"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
