# Background worker (BullMQ). Deploy alongside the Vercel web app on any
# container host (Railway, Fly.io, Render, ECS). Needs DATABASE_URL, REDIS_URL,
# ENCRYPTION_KEY, AUTH_SECRET and the same integration env vars as the web app.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci --ignore-scripts && npx prisma generate
COPY tsconfig.json ./
COPY src ./src
ENV NODE_ENV=production
CMD ["npx", "tsx", "src/workers/index.ts"]
